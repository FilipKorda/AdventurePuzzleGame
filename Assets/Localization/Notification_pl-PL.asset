--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Notification_pl-PL
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pl-PL
  m_SharedData: {fileID: 11400000, guid: 35546b6b8ebaa304486aa3efa25ad9aa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10504916992
    m_Localized: "Nie mo\u017Cna podnie\u015B\u0107 przedmiotu \u2014 pe\u0142ny
      ekwipunek"
    m_Metadata:
      m_Items: []
  - m_Id: 2274539884544
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A klucz."
    m_Metadata:
      m_Items: []
  - m_Id: 3388463140864
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A n\xF3\u017C.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 3953540747264
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A \u0142opate.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4117886160896
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A mlot.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 5719669886976
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A d\u017Awignie.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 6849158205440
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A Widelec.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 7168336351232
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A wytrych.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 13095684820992
    m_Localized: "Nie mo\u017Cna tego zrobi\u0107. Znajd\u017A krzemie\u0144.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 27964513472512
    m_Localized: "Musisz wybra\u0107 pusty wiadro, aby go nape\u0142ni\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 29559070412800
    m_Localized: "Wybierz sk\u0142adnik z ekwipunku, aby go doda\u0107 do kot\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 30581130022912
    m_Localized: "Podpal ogie\u0144 zanim  bedziesz wk\u0142ada\u0107 sk\u0142adniki 
      do kocio\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 31113806630912
    m_Localized: "Kocio\u0142 zawiera ju\u017C gotowy roztw\xF3r. Opr\xF3\u017Cnij
      go najpierw"
    m_Metadata:
      m_Items: []
  - m_Id: 31485489074176
    m_Localized: "Mikstura jest w trakcie gotowania \u2014 poczekaj a\u017C proces
      si\u0119 zako\u0144czy"
    m_Metadata:
      m_Items: []
  - m_Id: 39498971107328
    m_Localized: "Pobrano roztw\xF3r z kot\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 322717163474944
    m_Localized: "Znajd\u017A poprawn\u0105 sekwencje\nNacisnij [A-D] aby przesuwac
      wytrych\nNacisnij [E] aby zatwierdzic wybor\nNacisnij [PPM] aby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 5751635437703168
    m_Localized: Nie posiadasz recept
    m_Metadata:
      m_Items: []
  - m_Id: 5759029861437440
    m_Localized: "Najpierw otw\xF3rz k\u0142\xF3dke"
    m_Metadata:
      m_Items: []
  - m_Id: 8346026002108416
    m_Localized: "Znajd\u017C ksi\u0105\u017Ck\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 8652465157459968
    m_Localized: "Nacisnij [F] \u017Ceby prze\u0142\u0105czy\u0107 lampe "
    m_Metadata:
      m_Items: []
  - m_Id: 9166761536802816
    m_Localized: Potrzebujesz Terminalu
    m_Metadata:
      m_Items: []
  - m_Id: 11473856986632192
    m_Localized: "Mysz \u017Ceby ruszy\u0107 \nPPM \u017Ceby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 11885436626817024
    m_Localized: "Naci\u015Bnij PPM \u017Ceby si\u0119 napi\u0107 lub zje\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 12015488773410816
    m_Localized: "Naci\u015Bnij PPM \u017Ceby obraca\u0107 z\u0119batki\nNaci\u015Bnij
      E \u017Ceby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 13340150388248576
    m_Localized: "Ruch [W] i [S]\nNaci\u015Bnij E \u017Ceby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 13340387978792960
    m_Localized: "Ruch [A] i [D]\nNaci\u015Bnij E \u017Ceby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 13480168645742592
    m_Localized: "Naci\u015Bnij PPM \u017Ceby nacisn\u0105\u0107\nNaci\u015Bnij E
      \u017Ceby wyj\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 13655693615976448
    m_Localized: "Potrzebujesz miecz \u017Ceby go tu postawi\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 13691247233617920
    m_Localized: Potrzebujesz diamentowy klucz
    m_Metadata:
      m_Items: []
  - m_Id: 14131604341673984
    m_Localized: "Znajd\u017A szmaragdowy klucz"
    m_Metadata:
      m_Items: []
  - m_Id: 14413188093464576
    m_Localized: "Znajd\u017A rure"
    m_Metadata:
      m_Items: []
  - m_Id: 14728209172287488
    m_Localized: Akcja zablokowana
    m_Metadata:
      m_Items: []
  - m_Id: 15602162887577600
    m_Localized: "Nie ka\u017Cda \u015Bciana jest tak twarda, jak chce niezale\u017Cne.
      Tam, gdzie wiedza spoczywa na p\xF3\u0142kach, a rury zimne dostarczaj\u0105
      pusty szum, ukrywaj\u0105 si\u0119 s\u0142abo. Obok miejsca, gdzie widzisz
      cudze p\u0142aszcze, mur oddychaj\u0105cy ciszej. Nie klucz, nie s\u0142owo,
      lecz si\u0142a d\u0142oni obudzi si\u0119 do przej\u015Bcia. Uderz g\xF3rnik\xF3w,
      a kamie\u0144 ust\u0105pi, ods\u0142aniaj\u0105c si\u0119, co ukryte."
    m_Metadata:
      m_Items: []
  - m_Id: 17762438814650368
    m_Localized: "Dw\xF3ch rycerzy strze\u017Ce sarkofagu.\r\nJeden dzier\u017Cy
      ostrze, kt\xF3re tnie bez lito\u015Bci.\r\nDrugi niesie bro\u0144, co mia\u017Cd\u017Cy,
      lecz nie rozcina.\r\n\r\nTam, gdzie s\u0142o\u0144ce nigdy nie wschodzi,\r\nkamie\u0144
      oczekuje si\u0142y uderzenia.\r\nTam, gdzie cie\u0144 jest najkr\xF3tszy,\r\nczeka
      na precyzj\u0119 ostrza.\r\n\r\nBrama nie ust\u0105pi przed przypadkiem \u2014\r\ntylko
      w\u0142a\u015Bciwa bro\u0144 odnajdzie swoje miejsce."
    m_Metadata:
      m_Items: []
  - m_Id: 17764455888998400
    m_Localized: "Dwa szkielety stoj\u0105 naprzeciw siebie,\ncho\u0107 ka\u017Cdy
      patrzy w inn\u0105 stron\u0119 \u015Bwiata.\n\nTam, gdzie rodzi si\u0119 \u015Bwiat\u0142o
      dnia,\nspoczywa ten, kt\xF3ry ufa\u0142 sprytowi, nie sile.\nRogi wznosi\u0142
      ku niebu,\nlecz walczy\u0142 kr\xF3tkim ostrzem, z bliska i w ciszy.\n\nTam,
      gdzie s\u0142o\u0144ce ko\u0144czy sw\xF3j bieg,\nstoi wojownik bez twarzy.\nJego
      he\u0142m nie zdradza\u0142 emocji,\na ci\u0119\u017Ckie ostrze rozstrzyga\u0142o
      los jednym zamachem.\n\nNie zamieniaj ich historii.\nKa\u017Cdy musi otrzyma\u0107
      to,\nz czym odszed\u0142 na wieczny spoczynek."
    m_Metadata:
      m_Items: []
  - m_Id: 19519784435863552
    m_Localized: Zablokowane
    m_Metadata:
      m_Items: []
  - m_Id: 20187890434985984
    m_Localized: "Prze\u0142\u0105czniki na \u015Bcianie?\nKa\u017Cdy z nich musi
      spojrze\u0107 w g\xF3r\u0119, by zapanowa\u0142o \u015Bwiat\u0142o. \nGdy cho\u0107
      jeden si\u0119 waha, ca\u0142o\u015B\u0107 tonie w cieniu.\nKrypteks? \nMilczy,
      dop\xF3ki znaki nie ustawi\u0105 si\u0119 w jedynej s\u0142usznej kolejno\u015Bci.\r\nDopiero
      wtedy tajemnica uzna, \u017Ce zosta\u0142a odgadni\u0119ta.\nWaga? \nGdy dwie
      strony d\u017Awigaj\u0105 ten sam ci\u0119\u017Car, milknie ka\u017Cdy przechy\u0142
      i ruch.\nWtedy wiesz, \u017Ce sprawiedliwo\u015B\u0107 liczb zatrzyma\u0142a
      wskaz\xF3wk\u0119 po\u015Brodku.\nCo one maj\u0105 ze sob\u0105 wsp\xF3lnego?\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 20549889320833024
    m_Localized: "Dw\xF3ch braci z rycerskiej rodziny:\r\nAbda zawsze k\u0142amie!\r\nAbdi
      zawsze m\xF3wi prawde!"
    m_Metadata:
      m_Items: []
  - m_Id: 24525789162917888
    m_Localized: "A mo\u017Ce uderzy\u0107 czym\u015B w ten dzwon?"
    m_Metadata:
      m_Items: []
  - m_Id: 24596963809054720
    m_Localized: Zamek
    m_Metadata:
      m_Items: []
  - m_Id: 24596976526184448
    m_Localized: "Ogr\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 24597086307897344
    m_Localized: "G\xF3ry"
    m_Metadata:
      m_Items: []
  - m_Id: 24597138883497984
    m_Localized: Lochy
    m_Metadata:
      m_Items: []
  - m_Id: 24597200829173760
    m_Localized: Cmentarz
    m_Metadata:
      m_Items: []
  - m_Id: 24942754939555840
    m_Localized: "Cztery znaki w\u0119druj\u0105 po krainie, w kt\xF3rej jeden obszar
      zawsze pozostaje pusty."
    m_Metadata:
      m_Items: []
  - m_Id: 24942820869820416
    m_Localized: "Pierwszy z nich le\u017Cy dok\u0142adnie pomi\u0119dzy surow\u0105
      wysoko\u015Bci\u0105 a mroczn\u0105 g\u0142\u0119bi\u0105 \u2013 nie bli\u017Cej
      \u017Cadnej z nich, lecz dok\u0142adnie po\u015Brodku drogi."
    m_Metadata:
      m_Items: []
  - m_Id: 24942822035836928
    m_Localized: "Drugi spoczywa w samym sercu zieleni, tam gdzie wszystko ro\u015Bnie
      najr\xF3wniej i nic nie rzuca cienia dalej ni\u017C trzeba."
    m_Metadata:
      m_Items: []
  - m_Id: 24942823285739520
    m_Localized: "Trzeci znalaz\u0142 swoje miejsce przy kamiennych murach, lecz
      trzyma si\u0119 strony, gdzie s\u0142o\u0144ce znika jako pierwsze."
    m_Metadata:
      m_Items: []
  - m_Id: 24942907754827776
    m_Localized: "Ostatni nie szuka ju\u017C ruchu ani \u017Cycia \u2013 pozosta\u0142
      tam, gdzie cisza ma imi\u0119 i pami\u0119\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 24943074428080128
    m_Localized: "Pi\u0105te miejsce czeka\u2026 ale nie dla \u017Cadnego z nich."
    m_Metadata:
      m_Items: []
  - m_Id: 25352447465902080
    m_Localized: "Pierwsza p\u0142ytka \n              przy kar"
    m_Metadata:
      m_Items: []
  - m_Id: 25352482207322112
    m_Localized: "Druga p\u0142ytka nac   \n            wej\u015Bcia do "
    m_Metadata:
      m_Items: []
  - m_Id: 25352501811499008
    m_Localized: "Trzecia p\u0142ytka bardzo odoso"
    m_Metadata:
      m_Items: []
  - m_Id: 25352603045220352
    m_Localized: 'naciskowa jest

      cianym symbolu diamentu.'
    m_Metadata:
      m_Items: []
  - m_Id: 25352629968457728
    m_Localized: "iskowa jest najbli\u017Cej     tego pomieszczenia."
    m_Metadata:
      m_Items: []
  - m_Id: 25352637618868224
    m_Localized: naciskowa jest bniona i samotna.
    m_Metadata:
      m_Items: []
  - m_Id: 26683938598834176
    m_Localized: "Nieznajomy wpis do ksi\u0119gi"
    m_Metadata:
      m_Items: []
  - m_Id: 26684097202245632
    m_Localized: Nieznajomy
    m_Metadata:
      m_Items: []
  - m_Id: 26684734858088448
    m_Localized: "Komnata go\u015Bcinna by\u0142a przestronna i ciep\u0142a, wype\u0142niona
      mi\u0119kkim \u015Bwiat\u0142em wpadaj\u0105cym przez wysokie okno. Na \u015Brodku
      sta\u0142o solidne \u0142\xF3\u017Cko przykryte jasn\u0105 narzut\u0105, a
      obok niego niewielki stolik z dzbanem \u015Bwie\u017Cej wody. \u015Aciany zdobi\u0142y
      proste arrasy, kt\xF3re t\u0142umi\u0142y d\u017Awi\u0119ki i nadawa\u0142y
      wn\u0119trzu przytulno\u015Bci. W powietrzu unosi\u0142 si\u0119 delikatny
      zapach drewna i zi\xF3\u0142. Ca\u0142o\u015B\u0107 sprawia\u0142a wra\u017Cenie
      miejsca stworzonego do odpoczynku i spokojnego snu."
    m_Metadata:
      m_Items: []
  - m_Id: 26686804474482688
    m_Localized: Pin Pad
    m_Metadata:
      m_Items: []
  - m_Id: 26688481336250368
    m_Localized: "Ksi\u0119ga Dw\xF3ch Braci"
    m_Metadata:
      m_Items: []
  - m_Id: 26689852353564672
    m_Localized: "Ksi\u0119ga Ojca Dw\xF3ch Braci"
    m_Metadata:
      m_Items: []
  - m_Id: 26690447227506688
    m_Localized: "Archiwum Ksi\u0119gi Zakazanej"
    m_Metadata:
      m_Items: []
  - m_Id: 26685760868732928
    m_Localized: '-'
    m_Metadata:
      m_Items: []
  - m_Id: 27788200116506624
    m_Localized: "Kliknij przycisk jak jeste\u015B pewny \u017Ce dobrze wpisa\u0142e\u015B
      kod\r\n\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 27841239883993088
    m_Localized: "[PPM] Otw\xF3rz/Zamknij t\u0105 ksi\u0105\u017Ck\u0119\n[Q E] Nast\u0119pna
      strona"
    m_Metadata:
      m_Items: []
  - m_Id: 27844950584741888
    m_Localized: "[PPM] Otw\xF3rz/Zamknij ten papirus"
    m_Metadata:
      m_Items: []
  - m_Id: 27853001677099008
    m_Localized: "[PPM] Otw\xF3rz/Zamknij ksi\u0105\u017Cke"
    m_Metadata:
      m_Items: []
  - m_Id: 27857162942566400
    m_Localized: "[LPM] \u017Beby zaznaczy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 27857690263048192
    m_Localized: "[LPM]  \u017Beby obraca\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 27858078009675776
    m_Localized: "Trzymaj [LPM] \u017Ceby przesun\u0105\u0107 obiekt"
    m_Metadata:
      m_Items: []
  - m_Id: 27861166191824896
    m_Localized: "[A] Obr\xF3\u0107 w lewo\n[D] Obr\xF3\u0107 w prawo"
    m_Metadata:
      m_Items: []
  - m_Id: 27862152557907968
    m_Localized: "Trzymaj [LPM] \u017Ceby ruszy\u0107\nNaci\u015Bnij [LPM] \u017Ceby
      obr\xF3ci\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 28288381748531200
    m_Localized: "Ale z ciebie mistrz k\u0142amstwa i prawdy xd, GRATULACJE, a klatka
      w\u0142a\u015Bnie posz\u0142a w g\xF3r\u0119 i udost\u0119pni\u0142a ci lustro."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
