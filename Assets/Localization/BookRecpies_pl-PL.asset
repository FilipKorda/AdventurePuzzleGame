  m_TableData:
  - m_Id: 5996040192
    m_Localized: "Tutaj mo\u017Cesz sprawdza\u0107 swoje receptury na mikstury,\nje\u017Celi
      jakie\u015B posiadasz mo\u017Cesz je w\u0142o\u017Cy\u0107 pod ten st\xF3\u0142,
      \nwtedy odrazu je zobaczysz w ksi\u0105\u017Cce. \nUwa\u017Caj bo jest ich
      a\u017C 10."
    m_Metadata:
      m_Items: []
  - m_Id: 45493800960
    m_Localized: "MIKSTURA KWASOWA\nDo Wytworzenia mikstury potrzebujesz:\nWiadro
