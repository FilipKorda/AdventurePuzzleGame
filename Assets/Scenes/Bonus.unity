  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'In a chamber deep underground, magic imprisons four faces. Each speaks
    the truth, but only one opens the passage.


    It gazes without emotion, cold
    as the stone of a dungeon, reveals nothing, promises nothing.


    It illuminates
    the darkness without spell or steel, breaks the curse not with force but with
    brilliance. Where it appears, the dungeon loses its power, and the path becomes
    free.


    It burns like a spell cast in the dark, sharp features and tension
    ready for battle.


    It drowns in shadow and the weight of defeat, eyes like
    closed doors, a heart dragging downward.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 201a24140b0d13f43a359014d5b531d4, type: 2}
