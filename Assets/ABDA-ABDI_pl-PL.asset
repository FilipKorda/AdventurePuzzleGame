  m_TableData:
  - m_Id: 6834900992
    m_Localized: "W skrzyni znajduj\u0119 si\u0119 czaszka."
    m_Metadata:
      m_Items: []
  - m_Id: 1265163849728
    m_Localized: "W skrzyni jest r\xF3g do picia."
    m_Metadata:
      m_Items: []
  - m_Id: 1722049384448
    m_Localized: "Na p\xF3\u0142ce z ksi\u0105\u017Ckami znajduj\u0105 sie tylko
      ksi\u0105zki i 1 \u015Bwiecznik."
    m_Metadata:
      m_Items: []
  - m_Id: 2313643380736
    m_Localized: "W celi wi\u0119ziennej znajduje sie skrzynia z tajemniczym kluczem
      otwieraj\u0105cym drzwi."
    m_Metadata:
      m_Items: []
  - m_Id: 2677583138816
    m_Localized: "W ukrytym pomieszczeniu za rega\u0142em z ksi\u0105\u017Ckami znajduje
      si\u0119 z\u0142oty kielich jedyny w swoim rodzaju."
    m_Metadata:
      m_Items: []
